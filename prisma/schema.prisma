generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  READER
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  AI_DRAFT
  REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SourceTier {
  A
  B
  C
}

enum CouncilRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AgentJobType {
  GENERATE_TOPIC
  COUNCIL_REVIEW
  ENRICH_METADATA
  REBUILD_RELATED
}

enum AgentJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum ReviewAlertStatus {
  OPEN
  RESOLVED
}

enum ContentReportType {
  ACCURACY
  SAFETY
  OUTDATED
  OTHER
}

enum ContentReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  role           Role            @default(READER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  reviews        Review[]
  reports        ContentReport[] @relation("ReportedByUser")
  authored       Article[]       @relation("ArticleAuthor")
  requestedJobs  GenerationJob[] @relation("RequestedByUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Article {
  id                String               @id @default(cuid())
  slug              String               @unique
  title             String
  summary           String
  bodyMarkdown      String
  status            ArticleStatus        @default(DRAFT)
  confidenceLabel   String               @default("REVIEW_REQUIRED")
  trustScore        Int                  @default(0)
  trustBreakdownJson Json?
  evidenceScore     Int                  @default(0)
  freshnessScore    Int                  @default(0)
  consensusScore    Int                  @default(0)
  scoreVersion      Int                  @default(1)
  nextReviewAt      DateTime?
  isAIGenerated     Boolean              @default(false)
  createdBy         String               @default("system")
  createdById       String?
  createdByUser     User?                @relation("ArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  publishedAt       DateTime?
  lastReviewedAt    DateTime?
  metadata          ArticleMetadata?
  citations         Citation[]
  revisions         ArticleRevision[]
  reviews           Review[]
  outgoingRelated   ArticleRelatedLink[] @relation("OutgoingRelated")
  incomingRelated   ArticleRelatedLink[] @relation("IncomingRelated")
  sourceJobs        GenerationJob[]      @relation("SourceArticle")
  generatedByJobs   GenerationJob[]      @relation("GeneratedArticle")
  councilRuns       CouncilRun[]
  reviewAlerts      ReviewAlert[]
  claims            ArticleClaim[]
  promptRuns        PromptRun[]
  reports           ContentReport[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([nextReviewAt])
}

model ArticleMetadata {
  id               String   @id @default(cuid())
  articleId        String   @unique
  seoTitle         String
  seoDescription   String
  keyFacts         Json
  tags             Json
  entities         Json
  readingLevel     String
  safetyFlags      Json
  generatedByModel String
  generatedAt      DateTime @default(now())
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Citation {
  id          String    @id @default(cuid())
  articleId   String
  title       String
  url         String
  sourceType  String
  publishedAt DateTime?
  freshnessDays Int?
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  claimCitations ClaimCitation[]
}

model ArticleRevision {
  id               String        @id @default(cuid())
  articleId        String
  version          Int
  contentMarkdown  String
  status           ArticleStatus
  generatedByModel String?
  notes            String?
  createdBy        String
  createdAt        DateTime      @default(now())
  article          Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  councilRuns      CouncilRun[]

  @@unique([articleId, version])
}

model Review {
  id         String         @id @default(cuid())
  articleId  String
  reviewerId String
  decision   ReviewDecision
  notes      String
  createdAt  DateTime       @default(now())
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

model ArticleRelatedLink {
  id              String   @id @default(cuid())
  sourceArticleId String
  targetArticleId String?
  targetSlug      String
  targetTitle     String
  score           Float
  reason          String
  createdAt       DateTime @default(now())
  sourceArticle   Article  @relation("OutgoingRelated", fields: [sourceArticleId], references: [id], onDelete: Cascade)
  targetArticle   Article? @relation("IncomingRelated", fields: [targetArticleId], references: [id], onDelete: SetNull)

  @@index([sourceArticleId])
  @@index([targetSlug])
  @@unique([sourceArticleId, targetSlug])
}

model GenerationJob {
  id                 String              @id @default(cuid())
  sourceArticleId    String?
  requestedById      String?
  topicSlug          String
  topicTitle         String
  status             GenerationJobStatus @default(QUEUED)
  phase              String              @default("QUEUED")
  progress           Int                 @default(0)
  model              String
  promptVersion      String?
  errorMessage       String?
  rawResponse        String?
  generatedArticleId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  startedAt          DateTime?
  finishedAt         DateTime?
  sourceArticle      Article?            @relation("SourceArticle", fields: [sourceArticleId], references: [id], onDelete: SetNull)
  generatedArticle   Article?            @relation("GeneratedArticle", fields: [generatedArticleId], references: [id], onDelete: SetNull)
  requestedBy        User?               @relation("RequestedByUser", fields: [requestedById], references: [id], onDelete: SetNull)
  promptRuns         PromptRun[]

  @@index([topicSlug, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
}

model SourceDomainPolicy {
  domain    String   @id
  tier      SourceTier
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouncilRun {
  id               String            @id @default(cuid())
  articleId        String
  articleRevisionId String?
  status           CouncilRunStatus  @default(RUNNING)
  scoreVersion     Int               @default(1)
  aggregateScore   Int               @default(0)
  breakdownJson    Json
  publishEligible  Boolean           @default(false)
  promptVersion    String?
  policyVersion    String?
  failureReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  article          Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleRevision  ArticleRevision?  @relation(fields: [articleRevisionId], references: [id], onDelete: SetNull)
  judgeResults     CouncilJudgeResult[]
  promptRuns       PromptRun[]

  @@index([articleId, createdAt])
}

model CouncilJudgeResult {
  id           String    @id @default(cuid())
  councilRunId String
  judgeName    String
  score        Int
  verdict      String
  rationale    String
  citationsJson Json
  groundingJson Json
  latencyMs    Int
  createdAt    DateTime  @default(now())
  councilRun   CouncilRun @relation(fields: [councilRunId], references: [id], onDelete: Cascade)

  @@index([councilRunId])
}

model AgentJob {
  id         String         @id @default(cuid())
  type       AgentJobType
  payloadJson Json
  status     AgentJobStatus @default(QUEUED)
  attempt    Int            @default(0)
  maxAttempts Int           @default(5)
  runAt      DateTime       @default(now())
  lockedAt   DateTime?
  lockedBy   String?
  lastError  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, runAt])
  @@index([status, runAt, updatedAt])
}

model ReviewAlert {
  id                String            @id @default(cuid())
  articleId         String
  previousTrustScore Int
  newTrustScore     Int
  reason            String
  status            ReviewAlertStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?
  article           Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, status])
  @@index([status, createdAt])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String
  version   Int
  body      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([key, active])
}

model PromptRun {
  id              String         @id @default(cuid())
  kind            String
  templateKey     String
  templateVersion Int
  model           String
  rawResponseRef  String?
  inputTokens     Int?
  outputTokens    Int?
  latencyMs       Int?
  articleId       String?
  generationJobId String?
  councilRunId    String?
  createdAt       DateTime       @default(now())
  article         Article?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  generationJob   GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  councilRun      CouncilRun?    @relation(fields: [councilRunId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([generationJobId, createdAt])
  @@index([councilRunId, createdAt])
}

model ArticleClaim {
  id            String         @id @default(cuid())
  articleId     String
  sectionHeading String
  claimText     String
  confidence    Int
  orderIndex    Int
  createdAt     DateTime       @default(now())
  article       Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  citations     ClaimCitation[]

  @@index([articleId, orderIndex])
}

model ClaimCitation {
  id         String       @id @default(cuid())
  claimId    String
  citationId String
  supportType String      @default("supports")
  createdAt  DateTime     @default(now())
  claim      ArticleClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  citation   Citation     @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([claimId, citationId])
  @@index([claimId, citationId])
}

model ContentReport {
  id         String              @id @default(cuid())
  articleId  String
  reporterId String?
  type       ContentReportType
  details    String
  status     ContentReportStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
  article    Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reporter   User?               @relation("ReportedByUser", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([articleId, status])
}
